# copy to .env (gitignored) and adjust; read by docker compose

# host port of the web ui (vite dev server) — open http://localhost:$WEB_PORT
WEB_PORT=5173

# debug: image (path from the repo root) the web ui uploads on page open; empty — off
DEBUG_IMAGE=packages/lib/tests/fixtures/poppies.jpg

# linked composer rows over one render (all composers together); empty — the server fallback, 4
RENDER_MAX_LAYERS=
