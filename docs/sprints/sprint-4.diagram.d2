composer-node: {
  layer-1.drag-drop-icon
  layer-2.drag-drop-icon
  layer-3.drag-drop-icon
  opacity-node
  isolate-channel-node
  blend-mode-node
  noize-node
  plus-button

  layer-1 -> opacity-node -> isolate-channel-node -> blend-mode-node
  layer-2 -> noize-node
}

