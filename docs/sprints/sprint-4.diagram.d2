vars: {
  d2-config: {
    layout-engine: dagre
  }
}

# sprint 4 — composer. spec: docs/sprints/sprint-4.spec.md
# решено 26.10 (docs/diary/2026-10-26_sprint-4-planning.md):
# - один output input-ноды → сколько угодно рёбер (xyflow умеет из коробки) — ни ноды-умножителя, ни кнопки «дублировать выход»
# - composer — обычная нода со строками-слоями, цепочки снаружи; группа (subflow) — после 1.0
# - blend mode — select в строке слоя, не нода; opacity — нода в цепочке (уже есть)
# - верхняя строка = верхний слой
# - preview-node и настройки экспорта в output — после 1.0, сначала обсуждение

direction: right

input-image: {
  label: "input"
}

chain-1: "layer 1 chain" {
  style.stroke-dash: 3
  opacity-node: "opacity"
  isolate-channel-node: "isolate channel"
  opacity-node -> isolate-channel-node
}

chain-2: "layer 2 chain" {
  style.stroke-dash: 3
  hue-noise-node: "hue noise"
}

composer-node: "composer" {
  layer-1: "⠿ layer 1 · [add ▾] · ×"
  layer-2: "⠿ layer 2 · [normal ▾] · ×"
  layer-3: "⠿ layer 3 · [normal ▾] · ×"
  plus-button: "+ layer"
}

output-node: "output" {
  label: "output\n(download png)"
}

# fan-out: одна точка выхода, три ребра
input-image -> composer-node.layer-3
input-image -> chain-2.hue-noise-node
input-image -> chain-1.opacity-node

chain-1.isolate-channel-node -> composer-node.layer-1
chain-2.hue-noise-node -> composer-node.layer-2

composer-node -> output-node

after-1-0: "after 1.0 — backlog" {
  style.stroke-dash: 3
  style.opacity: 0.6
  preview-node: "preview node\n(any point of the chain)"
  export-settings: "output: export settings"
  composer-group: "composer as a group (subflow)"
}

# ui — uiu точечно: fieldset ноды остаётся, отступы и цвета — из токенов uiu.
# правило — CLAUDE.md, раздел «UI styles — uiu first»
